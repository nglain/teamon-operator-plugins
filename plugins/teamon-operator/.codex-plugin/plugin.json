  "interface": {
    "displayName": "TeamON Operator",
    "shortDescription": "\u041a\u043e\u043c\u043f\u0430\u043d\u0438\u0438, \u0430\u0433\u0435\u043d\u0442\u044b \u0438 \u043a\u043e\u043d\u0442\u0435\u043a\u0441\u0442 \u0432 \u0432\u0430\u0448\u0435\u043c Codex.",
    "longDescription": "\u0420\u0430\u0431\u043e\u0447\u0435\u0435 \u043c\u0435\u0441\u0442\u043e \u043e\u043f\u0435\u0440\u0430\u0442\u043e\u0440\u0430: \u043f\u0440\u043e\u0441\u043c\u043e\u0442\u0440 \u0434\u0438\u0430\u043b\u043e\u0433\u043e\u0432 \u0438 \u043a\u043e\u043d\u0442\u0435\u043a\u0441\u0442\u0430, \u043f\u043e\u043c\u043e\u0449\u044c \u0438 \u043d\u0430\u0441\u0442\u0440\u043e\u0439\u043a\u0430 \u0447\u0435\u0440\u0435\u0437 \u0448\u0442\u0430\u0442\u043d\u044b\u0435 API \u043a\u043e\u043c\u043f\u0430\u043d\u0438\u0438. \u0422\u0440\u0435\u0431\u0443\u0435\u0442\u0441\u044f Node 24.14.1+ (\u0432\u0435\u0442\u043a\u0430 24) \u0438 \u043e\u0442\u0434\u0435\u043b\u044c\u043d\u043e \u0432\u044b\u0434\u0430\u043d\u043d\u044b\u0439 \u0434\u043e\u0441\u0442\u0443\u043f \u043a \u043a\u043e\u043c\u043f\u0430\u043d\u0438\u0438. \u041d\u0435 \u0443\u0441\u0442\u0430\u043d\u0430\u0432\u043b\u0438\u0432\u0430\u0435\u0442 \u0438 \u043d\u0435 \u043e\u0431\u043d\u043e\u0432\u043b\u044f\u0435\u0442 Core.",
    "developerName": "TeamON",
    "category": "Productivity",
    "capabilities": [
      "Write"
    ],
    "defaultPrompt": [
      "\u041f\u0440\u043e\u0432\u0435\u0440\u044c \u043f\u043e\u0434\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u0435 TeamON Operator \u0432 \u044d\u0442\u043e\u043c \u0447\u0430\u0442\u0435. \u041f\u043e\u043a\u0430 \u0442\u043e\u043b\u044c\u043a\u043e \u0447\u0442\u0435\u043d\u0438\u0435, \u0431\u0435\u0437 \u0441\u043f\u0438\u0441\u043a\u0430 \u043a\u043e\u043c\u043f\u0430\u043d\u0438\u0439."
